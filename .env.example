# QQ AppID/AppSecret are configured after startup in http://127.0.0.1:8080/admin.
# They are encrypted in the persistent data volume and must not be written here.

# Use true only when the bot and test resources are configured in QQ sandbox.
QQ_IS_SANDBOX=false

# The web admin username/password are set with "bot.cmd web account".
# Only a salted password hash is stored in the persistent data volume.
# Keep false for http://127.0.0.1. Set true only behind an HTTPS reverse proxy.
WEB_ADMIN_SECURE_COOKIE=false

# Personal Trickcal board page. Set the public HTTPS page URL before sharing it.
# Keep the default only for testing from the bot host itself.
TRICKCAL_WEB_PUBLIC_URL=http://127.0.0.1:8080/tr-board/
TRICKCAL_WEB_SECURE_COOKIE=false

# Gallery object storage. Keep local until COS has passed check-cos and the
# existing objects have been copied with migrate-cos. Never put COS keys here.
MEDIA_OBJECT_BACKEND=local
COS_BUCKET=
COS_REGION=
COS_PREFIX=qbot/media
COS_LOCAL_FALLBACK=true
COS_SECRET_ID_FILE=/run/secrets/qbot/cos-secret-id
COS_SECRET_KEY_FILE=/run/secrets/qbot/cos-secret-key

# Optional: FFXIV queries powered by OtterBot WebAPI.
# Run "bot.cmd otter-setup" (Windows) or "./bot.sh otter-setup" (Linux).
# OTTER_API_QQ is your personal numeric QQ, not the QQ Open Platform AppID.
OTTER_API_QQ=
OTTER_API_TOKEN=
OTTER_API_BASE=https://xn--v9x.net/api/
# Leave false when the QQ Open Platform has no trusted-domain approval.
OTTER_INCLUDE_URLS=false
# Minimum delay between all requests sharing this token, in seconds.
OTTER_GLOBAL_MIN_INTERVAL=0.25

# Optional modern DPS and raid queries powered by the official FF Logs API v2.
# CN: https://cn.fflogs.com/api/clients/ ; global: https://www.fflogs.com/api/clients/
# Create a client on the site you use, then run
# "bot.cmd fflogs-setup" (Windows) or "./bot.sh fflogs-setup" (Linux).
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=
FFLOGS_DEFAULT_REGION=CN
# Leave blank to let FF Logs choose its current/default zone.
FFLOGS_DEFAULT_ZONE_ID=
FFLOGS_TIMEOUT=18
FFLOGS_CACHE_TTL=600
FFLOGS_GLOBAL_INTERVAL=0.5

# Native Bilibili live/dynamic subscriptions. Values are seconds; the worker
# seeds current state on its first check and never backfills historical posts.
BILILIVE_LIVE_INTERVAL=60
BILILIVE_DYNAMIC_INTERVAL=120
BILILIVE_OFF_NOTIFY=false
